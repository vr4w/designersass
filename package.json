{
  "name": "designersass",
  "version": "0.1.2",
  "description": "Offline CD cover studio",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "powershell -ExecutionPolicy Bypass -File packaging/build-pdf-exporter.ps1 && electron-builder --win nsis portable",
    "release:win": "powershell -ExecutionPolicy Bypass -File packaging/build-pdf-exporter.ps1 && electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "de.designersass.app",
    "productName": "DesignerSass",
    "publish": {
      "provider": "github",
      "owner": "vr4w",
      "repo": "designersass"
    },
    "files": [
      "index.html",
      "styles.css",
      "overrides.css",
      "print.css",
      "print-landscape.css",
      "contact.css",
      "app.js",
      "discord-config.js",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "dist-pdf/export_print_pdf.exe",
        "to": "export_print_pdf.exe"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "DesignerSass-${version}-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "DesignerSass"
    },
    "portable": {
      "artifactName": "DesignerSass-${version}-${arch}-portable.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
